# ===== Настройки бота «Окошко» =====
# 1. Вставьте сюда токен от @BotFather (выглядит как 1234567890:AAH...)
BOT_TOKEN=

# Часовой пояс мастеров (Москва по умолчанию). Примеры: Europe/Samara, Asia/Yekaterinburg, Asia/Novosibirsk
TIMEZONE=Europe/Moscow

# Адрес кабинета. Оставьте пустым — он создастся автоматически через туннель.
# Когда переедете на сервер с доменом, впишите сюда https://ваш-домен.ru
WEBAPP_URL=
TUNNEL=auto
PORT=8080

# Только для разработчика: проверка кабинета в обычном браузере. Оставьте 0.
DEV_USER_ID=0

# Необязательно: служебный бот, который присылает разработчику ошибки и события.
# LOG_BOT_TOKEN=
# Кто может подключиться к боту логов (username в Telegram без @)
LOG_OWNER=daniilkrivencev

# Сервер в России: Telegram ходит через мост (см. МОСТ_ДЛЯ_TELEGRAM.txt)
# TG_PROXY=socks5://127.0.0.1:1080
